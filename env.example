# ---- عمومی ----
PORT=3000
NODE_ENV=production
BASE_URL=http://localhost:3000

# ---- امنیت (حتما در سرور واقعی تغییر بده، این‌ها فقط نمونه هستند) ----
JWT_CUSTOMER_SECRET=change_this_to_a_long_random_string_customer
JWT_ADMIN_SECRET=change_this_to_a_totally_different_long_random_string_admin
SESSION_SECRET=change_this_to_another_long_random_string
ADMIN_PANEL_PATH=/nb-admin-x7q2

# فقط برای اولین بار که می‌خواهید یک شماره را ادمین کنید مقدار بده،
# بعد از استفاده حتما آن را از سرور حذف/خالی کن
ADMIN_SETUP_TOKEN=

# ---- پیامک (OTP) ----
# اگر پر نشود، سیستم روی "حالت آزمایشی" اجرا می‌شود و کد تایید در لاگ سرور چاپ می‌شود
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# ---- درگاه پرداخت زرین‌پال (نمونه، جایگزین قابل تغییر برای درگاه‌های دیگر مثل ملت) ----
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# ---- کارت به کارت (پرداخت دستی) ----
SHOP_CARD_NUMBER=6037-9975-XXXX-XXXX
SHOP_CARD_OWNER=نام صاحب فروشگاه ابزار نبهانی
