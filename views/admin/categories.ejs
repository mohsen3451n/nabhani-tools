<!DOCTYPE html>
<html lang="fa">
<head><%- include('../partials/head', { title: 'دسته‌بندی‌ها | پنل مدیریت' }) %></head>
<body>
  <%- include('../partials/admin-topbar') %>
  <div class="container">
    <a class="btn" href="<%= adminBase %>/categories/new">+ افزودن دسته‌بندی جدید</a>
    <% categories.forEach(function(c) { %>
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;margin-top:14px;">
        <div style="display:flex;gap:12px;align-items:center;">
          <img src="<%= c.image_url || '/img/placeholder.svg' %>" style="width:50px;height:50px;object-fit:cover;border-radius:50%;background:#0e0e0e;">
          <span><%= c.name %></span>
        </div>
        <div style="display:flex;gap:8px;">
          <a class="btn small secondary" href="<%= adminBase %>/categories/<%= c.id %>/edit">ویرایش</a>
          <form action="<%= adminBase %>/categories/<%= c.id %>/delete" method="POST" data-confirm="حذف شود؟"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger" type="submit">حذف</button></form>
        </div>
      </div>
    <% }) %>
  </div>
</body>
</html>
