<!DOCTYPE html>
<html lang="fa">
<head><%- include('../partials/head', { title: 'داشبورد | پنل مدیریت' }) %></head>
<body>
  <%- include('../partials/admin-topbar') %>
  <div class="container">
    <div class="stat-grid">
      <div class="stat-card"><div class="num"><%= stats.productsCount %></div><div class="label">تعداد کالاها</div></div>
      <div class="stat-card"><div class="num"><%= stats.ordersPending %></div><div class="label">سفارش‌های در انتظار</div></div>
      <div class="stat-card"><div class="num"><%= stats.ordersPaid %></div><div class="label">سفارش‌های پرداخت‌شده</div></div>
      <div class="stat-card"><div class="num"><%= stats.revenue.toLocaleString('fa-IR') %></div><div class="label">فروش کل (تومان)</div></div>
    </div>
    <a class="btn" href="<%= adminBase %>/products/new">+ افزودن کالای جدید</a>
  </div>
</body>
</html>
