<!DOCTYPE html>
<html lang="fa">
<head><%- include('../partials/head', { title: 'سفارش‌ها | پنل مدیریت' }) %></head>
<body>
  <%- include('../partials/admin-topbar') %>
  <div class="container">
    <div style="overflow-x:auto;">
    <table>
      <thead><tr><th>#</th><th>مشتری</th><th>مبلغ</th><th>روش پرداخت</th><th>وضعیت</th><th>تاریخ</th><th></th></tr></thead>
      <tbody>
        <% orders.forEach(function(o) { %>
        <tr>
          <td>#<%= o.id %></td>
          <td><%= o.user_phone %></td>
          <td><%= o.total.toLocaleString('fa-IR') %></td>
          <td><%= o.payment_method === 'card2card' ? 'کارت به کارت' : 'درگاه بانکی' %></td>
          <td><span class="badge <%= o.status %>"><%= o.status %></span></td>
          <td><%= o.created_at %></td>
          <td><a class="btn small secondary" href="<%= adminBase %>/orders/<%= o.id %>">جزئیات</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </div>
</body>
</html>
