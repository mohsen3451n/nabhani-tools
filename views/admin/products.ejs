<!DOCTYPE html>
<html lang="fa">
<head><%- include('../partials/head', { title: 'محصولات | پنل مدیریت' }) %></head>
<body>
  <%- include('../partials/admin-topbar') %>
  <div class="container">
    <a class="btn" href="<%= adminBase %>/products/new">+ افزودن کالای جدید</a>
    <div style="overflow-x:auto;margin-top:16px;">
    <table>
      <thead><tr><th>نام</th><th>دسته</th><th>قیمت</th><th>موجودی</th><th>وضعیت</th><th>عملیات</th></tr></thead>
      <tbody>
        <% products.forEach(function(p) { %>
        <tr>
          <td><%= p.name %></td>
          <td><%= p.category_name || '-' %></td>
          <td><%= p.price.toLocaleString('fa-IR') %></td>
          <td><%= p.stock %></td>
          <td><%= p.active ? 'فعال' : 'غیرفعال' %></td>
          <td style="display:flex;gap:6px;">
            <a class="btn small secondary" href="<%= adminBase %>/products/<%= p.id %>/edit">ویرایش</a>
            <form action="<%= adminBase %>/products/<%= p.id %>/delete" method="POST" data-confirm="حذف شود؟">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn small danger" type="submit">حذف</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </div>
</body>
</html>
