<!DOCTYPE html>
<html lang="fa">
<head><%- include('../partials/head', { title: 'تنظیمات فروشگاه | پنل مدیریت' }) %></head>
<body>
  <%- include('../partials/admin-topbar') %>
  <div class="container">
    <% if (saved) { %><div class="alert info">تنظیمات با موفقیت ذخیره شد.</div><% } %>
    <div class="card">
      <div class="section-title" style="margin-top:0;">اطلاعات تماس</div>
      <form action="<%= adminBase %>/settings" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label>شماره تماس فروشگاه</label><input type="text" name="shop_phone" value="<%= settings.shop_phone %>" placeholder="09120000000"></div>
        <div class="field"><label>لینک صفحه اینستاگرام</label><input type="text" name="shop_instagram" value="<%= settings.shop_instagram %>" placeholder="https://instagram.com/your_page"></div>
        <div class="section-title" style="margin-top:24px;">اطلاعات کارت (کارت‌به‌کارت)</div>
        <div class="field"><label>شماره کارت فروشگاه</label><input type="text" name="shop_card_number" value="<%= settings.shop_card_number %>"></div>
        <div class="field"><label>نام صاحب کارت</label><input type="text" name="shop_card_owner" value="<%= settings.shop_card_owner %>"></div>
        <button class="btn" type="submit">ذخیره تنظیمات</button>
      </form>
    </div>
    <div class="card">
      <div class="section-title" style="margin-top:0;">درگاه بانکی آنلاین (زرین‌پال)</div>
      <p style="color:var(--text-dim);font-size:13px;">برای فعال شدن، اول در zarinpal.com پذیرنده شوید و شناسه پذیرندگی بگیرید.</p>
      <form action="<%= adminBase %>/settings" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="shop_phone" value="<%= settings.shop_phone %>">
        <input type="hidden" name="shop_instagram" value="<%= settings.shop_instagram %>">
        <input type="hidden" name="shop_card_number" value="<%= settings.shop_card_number %>">
        <input type="hidden" name="shop_card_owner" value="<%= settings.shop_card_owner %>">
        <div class="field"><label>شناسه پذیرندگی زرین‌پال</label><input type="text" name="zarinpal_merchant_id" value="<%= settings.zarinpal_merchant_id %>"></div>
        <div class="field"><label style="display:flex;align-items:center;gap:8px;color:#fff;"><input type="checkbox" name="zarinpal_sandbox" value="1" <%= settings.zarinpal_sandbox !== 'false' ? 'checked' : '' %> style="width:auto;">حالت آزمایشی</label></div>
        <button class="btn" type="submit">ذخیره تنظیمات درگاه</button>
      </form>
    </div>
  </div>
</body>
</html>
