<!DOCTYPE html>
<html lang="fa">
<head><%- include('partials/head', { title: category.name + ' | ابزار نبهانی' }) %></head>
<body>
  <%- include('partials/topbar') %>
  <div class="container">
    <div class="section-title"><%= category.name %></div>
    <div class="product-grid">
      <% products.forEach(function(p) { %>
        <a class="product-card" href="/product/<%= p.slug %>">
          <img src="<%= p.image_url %>" alt="<%= p.name %>">
          <div class="name"><%= p.name %></div>
          <div class="price"><%= p.price.toLocaleString('fa-IR') %> تومان</div>
          <div class="stock"><%= p.stock > 0 ? 'موجود' : 'ناموجود' %></div>
        </a>
      <% }) %>
      <% if (products.length === 0) { %>
        <p>کالایی در این دسته ثبت نشده است.</p>
      <% } %>
    </div>
  </div>
  <%- include('partials/bottom-nav') %>
</body>
</html>
