<!DOCTYPE html>
<html lang="fa">
<head><%- include('partials/head', { title: 'کد تایید | ابزار نبهانی' }) %></head>
<body>
  <div class="container" style="padding-top:60px;">
    <div class="brand" style="text-align:center;font-size:26px;font-weight:bold;color:var(--green);margin-bottom:24px;">ابزار نبهانی</div>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>

    <div class="card">
      <p>کد ۵ رقمی ارسال‌شده به شماره <strong><%= phone %></strong> را وارد کنید.</p>
      <form action="/login/verify-code" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="phone" value="<%= phone %>">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label>کد تایید</label>
          <input type="text" name="code" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" required autofocus>
        </div>
        <button class="btn" type="submit">تایید و ورود</button>
      </form>
      <p class="otp-note">کد تا ۲ دقیقه اعتبار دارد.</p>
    </div>
  </div>
</body>
</html>
