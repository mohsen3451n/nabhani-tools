<!DOCTYPE html>
<html lang="fa">
<head><%- include('partials/head', { title: 'سفارش‌های من | ابزار نبهانی' }) %></head>
<body>
  <%- include('partials/topbar') %>
  <div class="container">
    <div class="section-title">سفارش‌های من</div>
    <% orders.forEach(function(o) { %>
      <div class="card">
        <div style="display:flex;justify-content:space-between;"><span>سفارش #<%= o.id %></span><span class="badge <%= o.status %>"><%= o.status %></span></div>
        <div style="margin-top:6px;color:var(--text-dim);"><%= o.created_at %></div>
        <div class="price" style="margin-top:6px;"><%= o.total.toLocaleString('fa-IR') %> تومان</div>
        <% if (['pending','awaiting_verification'].includes(o.status)) { %>
          <form action="/order/<%= o.id %>/cancel" method="POST" data-confirm="این سفارش لغو شود؟" style="margin-top:10px;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn danger small" type="submit">لغو سفارش</button>
          </form>
        <% } %>
      </div>
    <% }) %>
    <% if (orders.length === 0) { %><p>هنوز سفارشی ثبت نکرده‌اید.</p><% } %>
    <form action="/logout" method="POST" style="margin-top:20px;"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn secondary" type="submit">خروج از حساب</button></form>
  </div>
  <%- include('partials/bottom-nav') %>
</body>
</html>
