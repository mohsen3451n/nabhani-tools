<div class="topbar">
  <div class="topbar-row">
    <button type="button" class="menu-btn" id="siteMenuBtn" aria-label="منو">⋮</button>
    <div class="brand">ابزار نبهانی</div>
    <span style="width:36px;"></span>
  </div>
  <form class="search-box" action="/search" method="GET">
    <span>🔍</span>
    <input type="text" name="q" placeholder="جستجو در کالاهای ابزار نبهانی" value="<%= typeof q !== 'undefined' ? q : '' %>">
  </form>
</div>

<div class="site-menu-overlay" id="siteMenuOverlay"></div>
<div class="site-menu" id="siteMenu">
  <div class="site-menu-title">فروشگاه ابزار نبهانی</div>
  <% if (shopPhone) { %>
    <a href="tel:<%= shopPhone %>" class="site-menu-item">📞 تماس با ما: <%= shopPhone %></a>
  <% } %>
  <% if (shopInstagram) { %>
    <a href="<%= shopInstagram %>" target="_blank" rel="noopener" class="site-menu-item">📷 صفحه اینستاگرام ما</a>
  <% } %>
  <a href="<%= adminPanelPath %>/login" class="site-menu-item admin">🔐 ورود به پنل مدیریت</a>
</div>
